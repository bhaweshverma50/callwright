# Base URL of the Callwright API (services/api). Default when unset: http://localhost:8100/v1
VITE_API_BASE_URL=http://localhost:8100/v1
# true serves every /v1 request from the in-browser mock service worker (src/mocks)
VITE_API_MOCKS=false
# Where the Enterprise page "Contact sales" link goes
VITE_SALES_CONTACT_URL=mailto:sales@callwright.dev
# Cloudflare Turnstile site key. When set, the register form shows the captcha (the API needs TURNSTILE_SECRET_KEY)
VITE_TURNSTILE_SITE_KEY=

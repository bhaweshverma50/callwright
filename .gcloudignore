# Upload filter for `gcloud builds submit .` (deploy/cloudrun/cloudbuild.yaml builds the API image,
# deploy/vm/cloudbuild-voice.yaml the voice worker image). Only services/ is needed.
.gcloudignore
.git
.gitignore
.claude/
.github/
.impeccable/
.specify/
apps/
contracts/
research/
specs/
**/node_modules/
**/.venv/
**/__pycache__/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.env
**/.env.*
services/api/tests/
services/voice-worker/tests/

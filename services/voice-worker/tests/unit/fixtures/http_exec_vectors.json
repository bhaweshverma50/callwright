{
  "_comment": "Shared HTTP tool vectors (005 T035). An identical copy lives in services/voice-worker/tests/unit/fixtures/; a test in each service checks both copies match.",
  "requests": [
    {
      "name": "post sends arguments as the body when there is no template",
      "spec": {"method": "POST", "url": "https://api.example.com/slots", "headers": [{"name": "Content-Type", "value": "application/json", "secret": false}], "body_template": null},
      "arguments": {"date": "2026-10-20", "party": 2},
      "expect": {"method": "POST", "url": "https://api.example.com/slots", "body": {"date": "2026-10-20", "party": 2}, "headers": {"Content-Type": "application/json"}, "missing": []}
    },
    {
      "name": "get places arguments in the query",
      "spec": {"method": "GET", "url": "https://api.example.com/slots?clinic=1", "headers": [], "body_template": null},
      "arguments": {"date": "2026-10-20", "urgent": true},
      "expect": {"method": "GET", "url": "https://api.example.com/slots?clinic=1&date=2026-10-20&urgent=true", "body": null, "headers": {}, "missing": []}
    },
    {
      "name": "url placeholders are percent-encoded",
      "spec": {"method": "GET", "url": "https://api.example.com/patients/{{name}}/visits", "headers": [], "body_template": {}},
      "arguments": {"name": "Ana Lopez/Jr?"},
      "expect": {"method": "GET", "url": "https://api.example.com/patients/Ana%20Lopez%2FJr%3F/visits", "body": null, "headers": {}, "missing": []}
    },
    {
      "name": "lookup order is dynamic variables then arguments then mapped variables",
      "spec": {"method": "POST", "url": "https://api.example.com/x", "headers": [], "body_template": {"a": "{{who}}", "b": "{{caller_id}}", "c": "{{booking_ref}}"}},
      "arguments": {"who": "from-args"},
      "dynamic": {"who": "from-dynamic", "caller_id": "+14155550100"},
      "mapped": {"caller_id": "from-mapped", "booking_ref": "BK-1"},
      "expect": {"method": "POST", "url": "https://api.example.com/x", "body": {"a": "from-dynamic", "b": "+14155550100", "c": "BK-1"}, "headers": {"Content-Type": "application/json"}, "missing": []}
    },
    {
      "name": "a whole-string placeholder keeps the JSON type",
      "spec": {"method": "POST", "url": "https://api.example.com/x", "headers": [], "body_template": {"count": "{{n}}", "flag": "{{ok}}", "obj": "{{o}}", "text": "n={{n}}"}},
      "arguments": {"n": 3, "ok": false, "o": {"k": [1, 2]}},
      "expect": {"method": "POST", "url": "https://api.example.com/x", "body": {"count": 3, "flag": false, "obj": {"k": [1, 2]}, "text": "n=3"}, "headers": {"Content-Type": "application/json"}, "missing": []}
    },
    {
      "name": "substitution is JSON safe",
      "spec": {"method": "POST", "url": "https://api.example.com/x", "headers": [], "body_template": {"note": "Caller said: {{said}}"}},
      "arguments": {"said": "\"}, \"admin\": true, {\""},
      "expect": {"method": "POST", "url": "https://api.example.com/x", "body": {"note": "Caller said: \"}, \"admin\": true, {\""}, "headers": {"Content-Type": "application/json"}, "missing": []}
    },
    {
      "name": "dotted names read nested arguments",
      "spec": {"method": "POST", "url": "https://api.example.com/x", "headers": [{"name": "X-Customer", "value": "{{customer.id}}", "secret": false}], "body_template": {"name": "{{customer.name}}"}},
      "arguments": {"customer": {"id": "c-9", "name": "Ana"}},
      "expect": {"method": "POST", "url": "https://api.example.com/x", "body": {"name": "Ana"}, "headers": {"X-Customer": "c-9", "Content-Type": "application/json"}, "missing": []}
    },
    {
      "name": "missing variables are reported",
      "spec": {"method": "POST", "url": "https://api.example.com/{{tenant}}", "headers": [], "body_template": {"d": "{{date}}"}},
      "arguments": {},
      "expect": {"method": "POST", "url": "https://api.example.com/", "body": {"d": null}, "headers": {"Content-Type": "application/json"}, "missing": ["tenant", "date"]}
    },
    {
      "name": "secret headers come from the secret map",
      "spec": {"method": "DELETE", "url": "https://api.example.com/b/1", "headers": [{"name": "Authorization", "secret": true, "secret_ref": "ref-1"}], "body_template": null},
      "arguments": {},
      "secrets": {"ref-1": "Bearer t0ken"},
      "expect": {"method": "DELETE", "url": "https://api.example.com/b/1", "body": null, "headers": {"Authorization": "Bearer t0ken"}, "missing": []}
    },
    {
      "name": "an unavailable secret is reported",
      "spec": {"method": "POST", "url": "https://api.example.com/b", "headers": [{"name": "Authorization", "secret": true, "secret_ref": "gone"}], "body_template": null},
      "arguments": {},
      "secrets": {},
      "expect": {"method": "POST", "url": "https://api.example.com/b", "body": {}, "headers": {"Content-Type": "application/json"}, "missing": ["secret:Authorization"]}
    }
  ],
  "mappings": [
    {
      "name": "dot paths with indexes",
      "body": "{\"data\": {\"slots\": [{\"time\": \"10:00\"}, {\"time\": \"11:00\"}]}, \"ok\": true}",
      "mappings": [{"variable_name": "next_slot", "json_path": "data.slots[0].time"}, {"variable_name": "second", "json_path": "data.slots[1].time"}, {"variable_name": "ok", "json_path": "ok"}],
      "expect": {"mapped": {"next_slot": "10:00", "second": "11:00", "ok": true}, "missing": []}
    },
    {
      "name": "missing paths are listed and objects map whole",
      "body": "{\"data\": {\"slots\": []}}",
      "mappings": [{"variable_name": "next_slot", "json_path": "data.slots[0].time"}, {"variable_name": "data", "json_path": "data"}],
      "expect": {"mapped": {"data": {"slots": []}}, "missing": ["data.slots[0].time"]}
    },
    {
      "name": "a non-JSON body maps nothing",
      "body": "<html>oops</html>",
      "mappings": [{"variable_name": "a", "json_path": "a"}],
      "expect": {"mapped": {}, "missing": ["a"]}
    }
  ],
  "payloads": [
    {"name": "JSON is compacted", "body": "{ \"a\" : 1,\n \"b\": [1, 2] }", "expect": "{\"a\":1,\"b\":[1,2]}"},
    {"name": "plain text is trimmed", "body": "  OK booked  \n", "expect": "OK booked"},
    {"name": "long bodies are truncated to 4000 characters", "body_repeat": {"text": "x", "times": 5000}, "expect_length": 4000, "expect_suffix": " ...[truncated]"}
  ]
}

        "start": {
          "anyOf": [
            {
              "$ref": "#/$defs/StartSection"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "stt": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stt"
        },
        "task": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskSection"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "tools": {
          "anyOf": [
            {
              "items": {
                "additionalProperties": true,
                "type": "object"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tools"
        },
        "transfer": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transfer"
        },
        "transitions": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/CompiledTransition"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transitions"
        },
        "tts": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tts"
        },
        "type": {
          "enum": [
            "start",
            "agent",
            "task",
            "condition",
            "say",
            "extract_variable",
            "webhook",
            "transfer",
            "end"
          ],
          "title": "Type",
          "type": "string"
        },
        "webhook": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Webhook"
        }
      },
      "required": [
        "type",
        "label"
      ],
      "title": "CompiledNode",
      "type": "object"
    },
    "CompiledTransition": {
      "additionalProperties": true,
      "properties": {
        "description": {
          "title": "Description",
          "type": "string"
        },
        "edge_id": {
          "title": "Edge Id",
          "type": "string"
        },
        "function_name": {
          "title": "Function Name",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "target_node_id": {
          "title": "Target Node Id",
          "type": "string"
        },
        "trigger": {
          "const": "llm_condition",
          "title": "Trigger",
          "type": "string"
        }

      "required": [
        "edge_id",
        "function_name",
        "description",
        "target_node_id",
        "trigger"
      ],
      "title": "CompiledTransition",
      "type": "object"
    },
    "DeclaredVariable": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "source_node_id": {
          "title": "Source Node Id",
          "type": "string"
        },
        "type": {
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "name",
        "source_node_id",
        "type"
      ],
      "title": "DeclaredVariable",
      "type": "object"
    },
    "EndSection": {
      "additionalProperties": true,
      "properties": {
        "message": {
          "title": "Message",
          "type": "string"

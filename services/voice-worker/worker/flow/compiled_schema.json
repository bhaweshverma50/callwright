          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Edge Id"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "next": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Next"
        }
      },
      "required": [
        "message",
        "allow_interruptions",
        "next",
        "edge_id"
      ],
      "title": "SaySection",
      "type": "object"
    },
    "StartSection": {
      "additionalProperties": true,
      "properties": {
        "edge_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }

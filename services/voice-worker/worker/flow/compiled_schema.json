        },
        "greeting": {
          "title": "Greeting",
          "type": "string"
        },
        "greeting_type": {
          "enum": [
            "static",
            "generated"
          ],
          "title": "Greeting Type",
          "type": "string"
        },
        "next": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Next"
        },
        "start_speaker": {
          "enum": [
            "agent",
            "user"
          ],
          "title": "Start Speaker",
          "type": "string"
        }
      },
      "required": [
        "start_speaker",
        "greeting_type",
        "greeting",
        "next",
        "edge_id"
      ],
      "title": "StartSection",
      "type": "object"
    },
    "TaskSection": {
      "additionalProperties": true,
      "properties": {
        "json_schema": {
          "additionalProperties": true,
          "title": "Json Schema",
          "type": "object"
        },
        "max_rounds": {
          "title": "Max Rounds",
          "type": "integer"
        },
        "success_edge_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Success Edge Id"
        },
        "success_target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Success Target"
        }
      },
      "required": [
        "json_schema",
        "max_rounds",
        "success_target",
        "success_edge_id"
      ],
      "title": "TaskSection",
      "type": "object"

{
  "$defs": {
    "CompiledNode": {
      "additionalProperties": true,
      "description": "One node; the compiler writes every value of the sections it fills (agent and task nodes\ncarry ``context_strategy``), so the worker reads them as given.",
      "properties": {
        "begin_message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Begin Message"
        },
        "condition": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Condition"
        },
        "context_strategy": {
          "anyOf": [
            {
              "enum": [
                "inherit",
                "summarize",
                "reset"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Context Strategy"
        },
        "end": {
          "anyOf": [
            {
              "$ref": "#/$defs/EndSection"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "extract": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Extract"
        },
        "instructions": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Instructions"
        },
        "kb_search": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kb Search"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Language"
        },
        "llm": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }

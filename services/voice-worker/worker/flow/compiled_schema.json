  "additionalProperties": true,
  "properties": {
    "builtin_variables": {
      "items": {
        "type": "string"
      },
      "title": "Builtin Variables",
      "type": "array"
    },
    "compiled_at": {
      "title": "Compiled At",
      "type": "string"
    },
    "declared_variables": {
      "items": {
        "$ref": "#/$defs/DeclaredVariable"
      },
      "title": "Declared Variables",
      "type": "array"
    },
    "entry_node_id": {
      "title": "Entry Node Id",
      "type": "string"
    },
    "flow_id": {
      "title": "Flow Id",
      "type": "string"
    },
    "graph_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Graph Hash",
      "type": "string"
    },
    "nodes": {
      "additionalProperties": {
        "$ref": "#/$defs/CompiledNode"
      },
      "title": "Nodes",
      "type": "object"
    },
    "persona_prompt": {
      "title": "Persona Prompt",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "flow_id",
    "graph_hash",
    "compiled_at",
    "entry_node_id",
    "persona_prompt",
    "builtin_variables",
    "declared_variables",
    "nodes"
  ],
  "title": "CompiledFlow",
  "type": "object"
}

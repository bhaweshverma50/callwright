**/*.pyc
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/.DS_Store
**/.env
**/.env.*
.claude
.github
.impeccable
.specify
apps
contracts
research
specs
deploy
services/api/tests
services/voice-worker/tests

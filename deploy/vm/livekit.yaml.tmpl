# Rendered to livekit.yaml by render-env.sh (keys and Redis password from Secret Manager).
port: 7880
bind_addresses: ["127.0.0.1"]
rtc:
  tcp_port: 7881
  port_range_start: 50000
  port_range_end: 50200
  use_external_ip: true
  # The voice worker runs on this host: offer a 127.0.0.1 candidate so its media stays on
  # loopback instead of hairpinning through the external IP. Browsers ignore it.
  enable_loopback_candidate: true
redis:
  address: 127.0.0.1:6379
  password: ${REDIS_PASSWORD}
keys:
  ${LIVEKIT_API_KEY}: ${LIVEKIT_API_SECRET}
logging:
  level: info

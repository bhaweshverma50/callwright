# Rendered to egress.yaml by render-env.sh when recordings are on (CW_RECORDINGS_ENABLED=true).
# LiveKit egress records each call's audio (both sides, one channel each) and uploads it to the
# bucket named in the request; the storage credentials come with the request, not from here.
api_key: ${LIVEKIT_API_KEY}
api_secret: ${LIVEKIT_API_SECRET}
ws_url: ws://127.0.0.1:7880
redis:
  address: 127.0.0.1:6379
  password: ${REDIS_PASSWORD}
health_port: 8194
log_level: info
# Audio-only recordings are light; the default cost would refuse them on this 2 vCPU host.
cpu_cost:
  audio_room_composite_cpu_cost: 0.5

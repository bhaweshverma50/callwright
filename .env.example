# Callwright local configuration. Copy to .env (repo root) or services/api/.env; the API reads
# both (services/api/.env wins). Every value below has a working offline default, so an empty
# .env runs the full stack with the local identity provider and fake Stripe.

# --- API (services/api) ---------------------------------------------------------------------
ENV=dev                                   # dev | test | prod (prod refuses dev defaults)
LOG_LEVEL=INFO
LOG_JSON=false
API_BASE_URL=http://localhost:8100        # used to build fake checkout URLs
WEB_BASE_URL=http://localhost:5180        # verify, reset and checkout return links
CORS_ORIGINS=["http://localhost:5180"]

# Postgres 16 + pgvector from docker-compose (host port 55432). The app role is subject to RLS,
# the admin role writes the global pricing catalog, the owner role runs migrations.
DATABASE_URL=postgresql+asyncpg://callwright_app:callwright_app@localhost:55432/callwright
DATABASE_ADMIN_URL=postgresql+asyncpg://callwright_admin:callwright_admin@localhost:55432/callwright
DATABASE_OWNER_URL=postgresql+asyncpg://callwright:callwright@localhost:55432/callwright
APP_DB_PASSWORD=callwright_app            # role passwords set by migration s001_0001
ADMIN_DB_PASSWORD=callwright_admin
REDIS_URL=redis://localhost:56379/0

# Identity provider: local (offline dev IdP, links logged and served at GET /v1/dev/mail)
# or supabase. Access tokens are JWTs; HS256 with AUTH_JWT_SECRET, or RS256/ES256 via JWKS.
AUTH_PROVIDER=local
AUTH_JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
AUTH_JWKS_URL=
AUTH_JWT_AUDIENCE=authenticated
AUTH_JWT_ISSUER=
AUTH_ACCESS_TOKEN_TTL_S=3600
SUPABASE_URL=                             # e.g. https://<project>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Payments: fake (local checkout page at /v1/dev/fake-checkout/{id}) or live (Stripe API).
STRIPE_MODE=fake
STRIPE_SECRET_KEY=                        # sk_test_... in live mode
STRIPE_WEBHOOK_SECRET=whsec_dev_fake_stripe_webhook_secret
STRIPE_WEBHOOK_TOLERANCE_S=300

# Business defaults (FR-002, research R13)
TRIAL_CREDIT_USD=5.00
DEFAULT_CONCURRENCY=5
CREDIT_GRACE_USD=0.50

# Secrets store master key (base64, 32 bytes): uv run python -m app.core.secrets genkey
# Secret settings above may also be given as enc:v1:... (python -m app.core.secrets encrypt).
SECRETS_MASTER_KEY=ZGV2LW9ubHktbWFzdGVyLWtleS0zMi1ieXRlcy0hISE=
SERVICE_TOKEN=dev-service-token           # bearer token for /v1/internal/* (voice worker)

# Throttling and rate limits
LOGIN_FAIL_LIMIT=5
LOGIN_FAIL_IP_LIMIT=20
LOGIN_FAIL_WINDOW_S=900
QUOTE_RATE_LIMIT_PER_MIN=60
AUTH_EMAIL_RATE_LIMIT_PER_HOUR=20

OTEL_EXPORTER_OTLP_ENDPOINT=              # e.g. http://localhost:4318; empty = no export

# --- Web (apps/web) -------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8100
VITE_SALES_CONTACT_URL=mailto:sales@callwright.dev

# --- Voice worker (services/voice-worker) ---------------------------------------------------
CALLWRIGHT_API_URL=http://localhost:8100
CALLWRIGHT_SERVICE_TOKEN=dev-service-token
WORKER_HEALTH_PORT=8190

# Callwright local configuration. Copy to .env (repo root) or services/api/.env; the API reads
# both (services/api/.env wins). Every value below has a working offline default, so an empty
# .env runs the full stack with the local identity provider and fake Stripe.

# --- API (services/api) ---------------------------------------------------------------------
ENV=dev                                   # dev | test | staging | prod (staging and prod refuse dev secrets)
LOG_LEVEL=INFO
LOG_JSON=false
API_BASE_URL=http://localhost:8100        # used to build fake checkout URLs
WEB_BASE_URL=http://localhost:5180        # verify, reset and checkout return links
CORS_ORIGINS=http://localhost:5180       # comma separated (a JSON list also works)
TRUSTED_PROXY_HOPS=0                      # proxies appending X-Forwarded-For (Cloud Run: 1)

# Postgres 16 + pgvector from docker-compose (host port 55432). The app role is subject to RLS,
# the admin role writes the global pricing catalog, the owner role runs migrations.
DATABASE_URL=postgresql+asyncpg://callwright_app:callwright_app@localhost:55432/callwright
DATABASE_ADMIN_URL=postgresql+asyncpg://callwright_admin:callwright_admin@localhost:55432/callwright
DATABASE_OWNER_URL=postgresql+asyncpg://callwright:callwright@localhost:55432/callwright
APP_DB_PASSWORD=callwright_app            # role passwords set by migration s001_0001
ADMIN_DB_PASSWORD=callwright_admin
REDIS_URL=redis://localhost:56379/0       # rediss:// for TLS (?ssl_cert_reqs=none only for self-signed tests)
REDIS_CONNECT_TIMEOUT_S=2
REDIS_SOCKET_TIMEOUT_S=5
# Hosted demo: the VM that runs Redis, LiveKit and the workers; set all three to start it when
# Redis is unreachable (deploy/cloudrun/README.md). Empty = never wake anything.
WAKE_VM_PROJECT=
WAKE_VM_ZONE=
WAKE_VM_NAME=

# Identity provider: local (offline dev IdP, links logged and served at GET /v1/dev/mail)
# or supabase. Access tokens are JWTs; HS256 with AUTH_JWT_SECRET, or RS256/ES256 via JWKS.
AUTH_PROVIDER=local
AUTH_JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
AUTH_JWKS_URL=
AUTH_JWT_AUDIENCE=authenticated
AUTH_JWT_ISSUER=
AUTH_ACCESS_TOKEN_TTL_S=3600
AUTH_AUTO_VERIFY_EMAIL=false              # demo only: register signs straight in, no email check
ALLOW_AUTO_VERIFY_IN_PRODUCTION=false     # ENV=prod refuses auto-verify without this
SUPABASE_URL=                             # e.g. https://<project>.supabase.co
SUPABASE_ANON_KEY=

# Payments: fake (local checkout page at /v1/dev/fake-checkout/{id}) or live (Stripe API).
STRIPE_MODE=fake
STRIPE_SECRET_KEY=                        # sk_test_... in live mode
STRIPE_WEBHOOK_SECRET=whsec_dev_fake_stripe_webhook_secret
STRIPE_WEBHOOK_TOLERANCE_S=300

# Business defaults (FR-002, research R13)
TRIAL_CREDIT_USD=5.00
DEFAULT_CONCURRENCY=5
CREDIT_GRACE_USD=0.50

# Secrets store master key (base64, 32 bytes): uv run python -m app.core.secrets genkey
# Secret settings above may also be given as enc:v1:... (python -m app.core.secrets encrypt).
SECRETS_MASTER_KEY=ZGV2LW9ubHktbWFzdGVyLWtleS0zMi1ieXRlcy0hISE=
SERVICE_TOKEN=dev-service-token           # bearer token for /v1/internal/* (voice worker)
# The API also accepts it as CALLWRIGHT_SERVICE_TOKEN (the worker's name, below); keep both equal.

# Throttling and rate limits
LOGIN_FAIL_LIMIT=5
LOGIN_FAIL_IP_LIMIT=20
LOGIN_FAIL_WINDOW_S=900
QUOTE_RATE_LIMIT_PER_MIN=60
AUTH_EMAIL_RATE_LIMIT_PER_HOUR=20

OTEL_EXPORTER_OTLP_ENDPOINT=              # e.g. http://localhost:4318; empty = no export

# Development routes: unset = on for ENV dev/test, off otherwise.
ENABLE_DEV_ROUTES=                        # /v1/dev/mail and fake storage previews
ENABLE_FAKE_CHECKOUT=                     # /v1/dev/fake-checkout (STRIPE_MODE=fake); unset follows ENABLE_DEV_ROUTES
ARQ_POLL_DELAY_S=0.5                      # jobs worker queue polling; 2 to 5 s on metered Redis (Upstash)

# --- Agent builder (002) ----------------------------------------------------------------------
# Object storage for uploaded background audio. fake keeps objects in process memory and serves
# previews through a signed dev route; s3 talks to S3 or the compose MinIO
# (docker compose --profile storage up -d minio: http://localhost:59000, callwright/callwright-secret).
STORAGE_MODE=fake                         # fake | s3
S3_ENDPOINT_URL=                          # empty = AWS; http://localhost:59000 for MinIO
S3_REGION=us-east-1
S3_BUCKET=callwright
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Voice browser listings. Without a key the provider serves its bundled sample list.
ELEVENLABS_API_KEY=
CARTESIA_API_KEY=
# API-side model gateway (prompt assistant). A missing provider key selects the deterministic
# fake model, so prompt suggestions work offline.
PROMPT_AI_MODEL=azure_openai/gpt-5-mini   # <provider>/<model>; provider azure_openai | openai | anthropic
PROMPT_AI_TIMEOUT_S=60
PROMPT_AI_RATE_LIMIT_PER_MIN=20
OPENAI_API_KEY=
# Voice worker: OpenAI service tier for agent replies (priority: about 250 ms faster, twice the price).
OPENAI_SERVICE_TIER=
AZURE_OPENAI_ENDPOINT=                    # https://<resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-04-01-preview
# Also read by the voice worker: agents on the anthropic provider (Claude) need it, and without it
# the API refuses their live calls (text simulations use offline scripts).
ANTHROPIC_API_KEY=
# After migrating, load the launch templates: make templates-sync (make migrate runs it).

# --- Voice runtime (003) ----------------------------------------------------------------------
# LiveKit media server, shared by the API and the voice worker. live talks to LIVEKIT_URL
# (livekit-server --dev serves ws://localhost:7880 with devkey/secret); fake records rooms,
# dispatches and recordings in memory and needs no media server (tests, UI work without calls).
LIVEKIT_MODE=live                         # live | fake (prod requires live)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_PUBLIC_URL=                       # URL browsers join; empty = LIVEKIT_URL
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret                 # dev default; prod refuses it
WORKER_AGENT_NAME=callwright-voice        # agent name the API dispatches the worker with
# Call recordings (room-composite egress, research R13): the bucket and credentials the egress
# service uploads with; empty endpoint = AWS.
RECORDINGS_ENABLED=true                   # false: every call is admitted not_recorded (no LiveKit egress service)
RECORDINGS_EGRESS_TIMEOUT_S=20            # a recording start slower than this counts as failed; the call goes on
RECORDINGS_BUCKET=callwright-recordings
RECORDINGS_S3_ENDPOINT=
RECORDINGS_S3_REGION=us-east-1
RECORDINGS_S3_ACCESS_KEY=
RECORDINGS_S3_SECRET_KEY=
# Outbound customer webhooks: https and public addresses only unless allowed (development only;
# prod refuses both).
WEBHOOKS_ALLOW_HTTP=false
WEBHOOKS_ALLOW_PRIVATE=false

# --- Web (apps/web) -------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8100
VITE_SALES_CONTACT_URL=mailto:sales@callwright.dev

# --- Voice worker (services/voice-worker) ---------------------------------------------------
CALLWRIGHT_INTERNAL_API_URL=http://localhost:8100/v1/internal
CALLWRIGHT_SERVICE_TOKEN=dev-service-token
WORKER_HEALTH_PORT=8190
CALLWRIGHT_OTEL_EXPORTER=none            # none | console | otlp
# Sanas noise cancellation (vendor SDK not bundled yet; without a key audio passes through and is not billed as NC)
SANAS_API_KEY=

# Post-call cost guard: calls shorter than ANALYSIS_MIN_DURATION_S, or where the caller said fewer than
# ANALYSIS_MIN_CALLER_CHARS characters, skip the AI summary and paid judge checks (free checks still run;
# a manual re-run forces them; 0 turns a rule off).
ANALYSIS_MIN_DURATION_S=15
ANALYSIS_MIN_CALLER_CHARS=40

# Testing and simulation (008). Persona callers, persona briefs and tool stand-ins use
# SIMULATOR_MODEL; test case drafts use TESTCASE_GENERATOR_MODEL (default: SIMULATOR_MODEL); test
# case judges use the default eval judge. SIM_MAX_CONCURRENCY caps the simulation runs and test
# cases one workspace executes at once (the rest wait their turn).
SIMULATOR_MODEL=openai/gpt-5-mini
TESTCASE_GENERATOR_MODEL=
SIM_MAX_CONCURRENCY=10
SIM_TIMEOUT_S=60
# Voice worker text runner (WORKER_ROLE=textsim): consumes queue arq:textsim on this Redis.
# REDIS_URL above; TEXTSIM_MAX_JOBS=10 and TEXTSIM_JOB_TIMEOUT_S=900 in the worker's environment.

# Issues and auto-fix (009). ISSUES_MODEL names detected issues and drafts fixes (default:
# SIMULATOR_MODEL). Validation runs through the simulation and evaluation settings above.
ISSUES_MODEL=
